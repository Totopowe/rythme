# Copie ce fichier en .env.local et remplis les valeurs. Ne commite jamais .env.local.

# --- Côté navigateur (publiques par nature, incluses dans le build) ---------------
# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API → clé « anon » / « publishable »
VITE_SUPABASE_ANON_KEY=

# --- Côté serveur uniquement (fonctions Vercel /api, jamais préfixées VITE_) ------
# Supabase → Project Settings → API → clé « service_role » / « secret ». SECRÈTE.
# Utilisée seulement par /api/admin pour lire les statistiques.
SUPABASE_SERVICE_ROLE_KEY=
# Adresse e-mail du compte autorisé à ouvrir /admin
ADMIN_EMAIL=

# Optionnel : adresse de contact affichée sur la page Confidentialité
VITE_CONTACT_EMAIL=
